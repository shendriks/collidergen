<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>collidergen</ToolCommandName>
        <PackageId>ColliderGen.Tool</PackageId>
        <Description>CLI that derives convex-hull colliders from sprite alpha masks.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="StbImageSharp" Version="2.30.16" />
        <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="ColliderGen.Tests" />
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ColliderGen\ColliderGen.csproj" />
    </ItemGroup>
</Project>
